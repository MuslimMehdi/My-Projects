#include <Servo.h>

// =========================
// PIN DEFINITIONS
// =========================

const byte TRIG_PIN = 7;
const byte ECHO_PIN = 8;

const byte SERVO_PIN = 9;

const byte LED_ON_PIN     = 2;
const byte LED_CLEAR_PIN  = 3;
const byte LED_DANGER_PIN = 4;

const byte BUZZER_PIN = 5;

// =========================
// RADAR SETTINGS
// =========================

const int MIN_ANGLE = 0;
const int MAX_ANGLE = 180;

const int ANGLE_STEP = 2;

// Maximum useful detection distance
const float MAX_DISTANCE_CM = 400.0;

// Distance thresholds
const float DANGER_DISTANCE_CM = 20.0;
const float PROXIMITY_DISTANCE_CM = 50.0;

// =========================
// TIMING
// =========================

const unsigned long SERVO_SETTLE_MS = 25;
const unsigned long BUZZER_INTERVAL_MS = 120;

// =========================
// OBJECTS
// =========================

Servo radarServo;

// =========================
// STATE
// =========================

int currentAngle = MIN_ANGLE;
int direction = 1;

unsigned long lastMoveTime = 0;
unsigned long lastBuzzerTime = 0;

bool buzzerState = false;

// =========================
// SETUP
// =========================

void setup() {

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(LED_ON_PIN, OUTPUT);
  pinMode(LED_CLEAR_PIN, OUTPUT);
  pinMode(LED_DANGER_PIN, OUTPUT);

  pinMode(BUZZER_PIN, OUTPUT);

  digitalWrite(TRIG_PIN, LOW);

  // System ON indicator
  digitalWrite(LED_ON_PIN, HIGH);

  digitalWrite(LED_CLEAR_PIN, LOW);
  digitalWrite(LED_DANGER_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  radarServo.attach(SERVO_PIN);

  // Start in the center
  radarServo.write(90);

  // Serial connection to PC
  Serial.begin(115200);

  delay(500);

  // Tell Python that the system is ready
  Serial.println("RADAR,READY");
}

// =========================
// MAIN LOOP
// =========================

void loop() {

  unsigned long now = millis();

  // Move and scan at controlled intervals
  if (now - lastMoveTime >= SERVO_SETTLE_MS) {

    lastMoveTime = now;

    radarServo.write(currentAngle);

    // Small mechanical settling time
    delay(3);

    float distance = measureDistance();

    const char* state = getState(distance);

    updateIndicators(state);
    updateBuzzer(state, now);

    // Send data to Python
    sendRadarData(currentAngle, distance, state);

    // Move to next angle
    currentAngle += direction * ANGLE_STEP;

    // Reverse at boundaries
    if (currentAngle >= MAX_ANGLE) {

      currentAngle = MAX_ANGLE;
      direction = -1;

    } else if (currentAngle <= MIN_ANGLE) {

      currentAngle = MIN_ANGLE;
      direction = 1;
    }
  }
}

// =========================
// DISTANCE MEASUREMENT
// =========================

float measureDistance() {

  // Make sure trigger starts LOW
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  // 10 us trigger pulse
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // Timeout prevents the program from hanging
  // ~23 ms is enough for approximately 4 m
  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 23000UL);

  // No echo
  if (duration == 0) {
    return -1.0;
  }

  // Speed of sound:
  // distance = time / 58 approximately
  float distance = duration / 58.0;

  // Reject impossible values
  if (distance <= 0.0 || distance > MAX_DISTANCE_CM) {
    return -1.0;
  }

  return distance;
}

// =========================
// DETERMINE RADAR STATE
// =========================

const char* getState(float distance) {

  // No valid object
  if (distance < 0) {
    return "CLEAR";
  }

  if (distance <= DANGER_DISTANCE_CM) {
    return "DANGER";
  }

  if (distance <= PROXIMITY_DISTANCE_CM) {
    return "PROXIMITY";
  }

  return "CLEAR";
}

// =========================
// LED INDICATORS
// =========================

void updateIndicators(const char* state) {

  // System is always ON while running
  digitalWrite(LED_ON_PIN, HIGH);

  if (strcmp(state, "DANGER") == 0) {

    digitalWrite(LED_CLEAR_PIN, LOW);
    digitalWrite(LED_DANGER_PIN, HIGH);

  } else {

    digitalWrite(LED_DANGER_PIN, LOW);
    digitalWrite(LED_CLEAR_PIN, HIGH);
  }
}

// =========================
// BUZZER
// =========================

void updateBuzzer(const char* state, unsigned long now) {

  if (strcmp(state, "DANGER") != 0) {

    buzzerState = false;
    digitalWrite(BUZZER_PIN, LOW);

    return;
  }

  // Non-blocking beep
  if (now - lastBuzzerTime >= BUZZER_INTERVAL_MS) {

    lastBuzzerTime = now;

    buzzerState = !buzzerState;

    digitalWrite(BUZZER_PIN, buzzerState);
  }
}

// =========================
// SERIAL OUTPUT
// =========================

void sendRadarData(
  int angle,
  float distance,
  const char* state
) {

  Serial.print(angle);
  Serial.print(",");

  if (distance < 0) {
    Serial.print(-1);
  } else {
    Serial.print(distance, 1);
  }

  Serial.print(",");
  Serial.println(state);
}
